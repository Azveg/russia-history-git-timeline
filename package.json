{
  "name": "historical-atlas-chronograph",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "prebuild": "rm -rf public/assets/aistudio dist/assets/aistudio",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "validate:branches": "node scripts/validate-branches.mjs",
    "validate:branches:strict": "node scripts/validate-branches.mjs --strict",
    "validate:style": "node scripts/validate-branches.mjs --check-style",
    "sync:catalog": "node scripts/sync-branch-catalog.mjs",
    "sync:catalog:check": "node scripts/sync-branch-catalog.mjs --check",
    "handoff:rotate": "node scripts/rotate-handoff.mjs",
    "sync:lock-integrity": "node scripts/sync-lock-integrity.mjs",
    "verify:invariants": "node scripts/verify-agent-invariants.mjs",
    "verify": "npm run verify:invariants && npm run validate:branches:strict && npm run sync:catalog:check && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.1.1"
  }
}
